# Porta HTTP do servidor
PORT=5000

# development | production
NODE_ENV=development

# Origens do cliente aceitas pelo CORS/Socket.IO, separadas por vírgula.
# Em produção defina a URL pública do cliente (ex.: https://truco.exemplo.com).
# Sem esta variável qualquer origem é aceita (apenas para desenvolvimento).
CLIENT_ORIGIN=http://localhost:3000

# true habilita logs detalhados de depuração mesmo em produção
DEBUG_LOGS=false

# Segundos que cada jogada/resposta pode levar antes da jogada automática (0 desliga)
TURN_TIMEOUT_SECONDS=60

# Minutos sem atividade para uma sala ser encerrada (0 desliga)
ROOM_IDLE_MINUTES=30

# Limites de abuso por endereço IP
MAX_CONNECTIONS_PER_IP=20
MAX_ROOMS_PER_IP=5

# true se o servidor está atrás de um proxy reverso (nginx etc.): o IP do cliente vem de X-Forwarded-For
TRUST_PROXY=false

# Arquivo onde salvar as salas e partidas para sobreviverem a um restart (vazio desliga)
# PERSIST_FILE=./data/state.json
